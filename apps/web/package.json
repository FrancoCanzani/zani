{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "CI=true wrangler d1 migrations apply app --local && vite --port 43123 --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.node.json",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "preview": "bun run build && vite preview --port 43123 --host 127.0.0.1",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@workspace/db": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "drizzle-orm": "^0.44.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.131.2"
  }
}
