{
  "name": "saas",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "cf-typegen": "turbo run cf-typegen",
    "db:generate": "turbo run db:generate",
    "db:migrate:dev": "bun run --filter web db:migrate:dev",
    "db": "bun run --filter web db"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
